DB_HOST=localhost
DB_PORT=5433
DB_NAME=hytter
DB_USER=hytter
DB_PASSWORD=hytter

# Set to true for local dev to bypass Keycloak and run as a fixed admin user.
AUTH_DISABLED=true
# Keycloak realm issuer, e.g. https://keycloak.example.com/realms/hytter
KEYCLOAK_ISSUER=
# Client ID whose client roles (resource_access.<clientId>.roles) map to admin/user
KEYCLOAK_CLIENT_ID=
# Confidential client secret (Keycloak client must have "Client authentication" on)
KEYCLOAK_CLIENT_SECRET=
# Externally reachable frontend origin; Keycloak redirects the browser here after login
PUBLIC_URL=http://localhost:3000
# Hex-encoded 16-byte keys for session cookie encryption. Leave blank in dev
# (a random key is generated at startup); set real values in every non-dev
# deployment so sessions survive restarts and are shared across replicas.
SESSION_ENCRYPT_KEY=
SESSION_SIGN_KEY=
# Upper bound on the session cookie's browser lifetime, in seconds (default
# 36000 = 10h). Only a backstop: the real limit is Keycloak's refresh token
# expiry, checked server-side on every request. Keep this >= Keycloak's SSO
# Session Max so the cookie never outlives the grant.
SESSION_MAX_AGE_SECONDS=
# Note: the session cookie's Secure flag is derived from PUBLIC_URL - it is set
# whenever PUBLIC_URL is https, so no separate setting is needed.

# Frontend (server-side only, used by server/middleware/proxy.ts)
NUXT_BACKEND_URL=http://localhost:8080
