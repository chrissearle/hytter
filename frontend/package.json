{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "prepare": "git -C .. config core.hooksPath .husky || true"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.142",
    "@iconify-json/simple-icons": "1.2.99",
    "h3": "1.15.11",
    "@nuxt/ui": "4.11.3",
    "nuxt": "4.6.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "26.6.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.11.2",
  "lint-staged": {
    "*.{js,ts,vue}": "pnpm lint:fix"
  }
}
