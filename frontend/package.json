{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "prepare": "git -C .. config core.hooksPath .husky || true",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@iconify-json/simple-icons": "1.2.101",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/ui": "4.12.0",
    "@prometheus-io/client": "0.16.1",
    "h3": "1.15.11",
    "nuxt": "4.6.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "26.6.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.16.0",
  "lint-staged": {
    "*.{js,mjs,ts,vue}": "pnpm lint:fix",
    "*.{md,json,css,yml,yaml}": "prettier --write --ignore-unknown"
  }
}
