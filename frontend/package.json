{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "prepare": "git -C .. config core.hooksPath .husky || true"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.136",
    "@iconify-json/simple-icons": "1.2.97",
    "h3": "1.15.11",
    "@nuxt/ui": "4.11.2",
    "nuxt": "4.5.2",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "26.6.2",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@12.6.0",
  "lint-staged": {
    "*.{js,ts,vue}": "pnpm lint:fix"
  }
}
