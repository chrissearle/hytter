{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "prepare": "husky ../.husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.114",
    "@iconify-json/simple-icons": "1.2.87",
    "@nuxt/ui": "4.9.0",
    "nuxt": "4.4.8",
    "tailwindcss": "4.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/node": "25.9.5",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.6.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.5"
  },
  "packageManager": "pnpm@10.28.1",
  "lint-staged": {
    "*.{js,ts,vue}": "pnpm lint:fix"
  }
}
