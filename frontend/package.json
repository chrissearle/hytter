{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "prepare": "husky ../.husky"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.118",
    "@iconify-json/simple-icons": "1.2.91",
    "h3": "1.15.11",
    "@nuxt/ui": "4.10.0",
    "nuxt": "4.5.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.16.0",
    "@types/node": "26.1.1",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "packageManager": "pnpm@11.15.1",
  "lint-staged": {
    "*.{js,ts,vue}": "pnpm lint:fix"
  }
}
